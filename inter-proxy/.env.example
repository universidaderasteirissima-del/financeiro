# Rasteirissima — Inter Proxy — variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env no git.
#
# Cada boleto vai para uma conta Inter diferente:
#   BRI  = Conta Brilhante/Fábrica  (para boletoBri1 e boletoBri2)
#   MKT  = Conta Marketing          (para boletoMkt)
#   FRAN = Conta Franchising        (para boletoFran)
#
# Para cada conta: faça login em developers.bancointer.com.br,
# crie uma aplicação, marque escopo boleto-cobranca.write e baixe o certificado.

# ── Conta Brilhante/Fábrica ───────────────────────────────────────────────────
INTER_BRI_CLIENT_ID=
INTER_BRI_CLIENT_SECRET=
# Cole o conteúdo do cert.pem com quebras de linha substituídas por \n
INTER_BRI_CERT_PEM=-----BEGIN CERTIFICATE-----\nMIIE...\n-----END CERTIFICATE-----
INTER_BRI_KEY_PEM=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----
# Número da conta corrente Inter PJ (deixe vazio se não souber)
INTER_BRI_CONTA=

# ── Conta Marketing ───────────────────────────────────────────────────────────
INTER_MKT_CLIENT_ID=
INTER_MKT_CLIENT_SECRET=
INTER_MKT_CERT_PEM=-----BEGIN CERTIFICATE-----\nMIIE...\n-----END CERTIFICATE-----
INTER_MKT_KEY_PEM=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----
INTER_MKT_CONTA=

# ── Conta Franchising ─────────────────────────────────────────────────────────
INTER_FRAN_CLIENT_ID=
INTER_FRAN_CLIENT_SECRET=
INTER_FRAN_CERT_PEM=-----BEGIN CERTIFICATE-----\nMIIE...\n-----END CERTIFICATE-----
INTER_FRAN_KEY_PEM=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----
INTER_FRAN_CONTA=

# ── Servidor ──────────────────────────────────────────────────────────────────
# URL do GitHub Pages onde o sistema está hospedado (sem barra final)
ALLOWED_ORIGIN=https://seuusuario.github.io
PORT=3000
