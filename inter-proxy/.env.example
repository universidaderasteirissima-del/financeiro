# Copie este arquivo para .env e preencha com suas credenciais reais
# NUNCA commite o arquivo .env no git

INTER_CLIENT_ID=seu_client_id_aqui
INTER_CLIENT_SECRET=seu_client_secret_aqui

# Conteúdo do cert.pem (baixado do Inter Developers)
# Cole o conteúdo completo numa linha só, substituindo quebras de linha por \n
INTER_CERT_PEM=-----BEGIN CERTIFICATE-----\nMIIE....\n-----END CERTIFICATE-----

# Conteúdo do key.pem (par da chave do certificado)
INTER_KEY_PEM=-----BEGIN PRIVATE KEY-----\nMIIE....\n-----END PRIVATE KEY-----

# Número da conta corrente Inter PJ (visível no internet banking)
INTER_CONTA=

# URL do sistema que pode chamar este proxy (sem barra no final)
# Ex: https://seuusuario.github.io
ALLOWED_ORIGIN=https://seuusuario.github.io

PORT=3000
